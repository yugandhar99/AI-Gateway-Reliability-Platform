{
  "uid": "ai-gateway",
  "title": "AI Gateway Reliability",
  "schemaVersion": 39,
  "version": 3,
  "refresh": "15s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Chat throughput",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "gateway-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(gateway_http_requests_total{route=\"/chat\"}[1m]))",
          "refId": "A",
          "legendFormat": "{{provider}} {{state}} {{__name__}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Chat HTTP error rate (4xx + 5xx)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "gateway-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "100 * (sum(rate(gateway_http_requests_total{route=\"/chat\",status=~\"[45]..\"}[5m])) or vector(0)) / clamp_min(sum(rate(gateway_http_requests_total{route=\"/chat\"}[5m])), 0.001)",
          "refId": "A",
          "legendFormat": "{{provider}} {{state}} {{__name__}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Chat P95 latency",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "gateway-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(gateway_http_request_duration_seconds_bucket{route=\"/chat\"}[5m])))",
          "refId": "A",
          "legendFormat": "{{provider}} {{state}} {{__name__}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Provider availability",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "gateway-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "gateway_provider_available",
          "refId": "A",
          "legendFormat": "{{provider}} {{state}} {{__name__}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Failover events",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "gateway-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (provider) (rate(gateway_failovers_total[5m]))",
          "refId": "A",
          "legendFormat": "{{provider}} {{state}} {{__name__}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "Circuit breaker states",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "gateway-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "gateway_circuit_breaker_state",
          "refId": "A",
          "legendFormat": "{{provider}} {{state}} {{__name__}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "title": "Provider failures and retries",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "gateway-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "{__name__=~\"gateway_provider_failures_total|gateway_retries_total\"}",
          "refId": "A",
          "legendFormat": "{{provider}} {{state}} {{__name__}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "title": "Aggregate estimated tokens",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "gateway-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "gateway_tokens_total",
          "refId": "A",
          "legendFormat": "{{provider}} {{state}} {{__name__}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "title": "Authentication and rate limit rejections",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "gateway-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "{__name__=~\"gateway_authentication_failures_total|gateway_rate_limits_total\"}",
          "refId": "A",
          "legendFormat": "{{provider}} {{state}} {{__name__}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "title": "Active incidents by severity",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "gateway-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "gateway_incidents_active",
          "refId": "A",
          "legendFormat": "{{severity}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 11,
      "title": "Resolved incidents",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "gateway-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "gateway_incidents_resolved_total",
          "refId": "A",
          "legendFormat": "Resolved"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 12,
      "title": "Human remediation approvals",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "gateway-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "gateway_incident_approvals_total",
          "refId": "A",
          "legendFormat": "Approvals"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 13,
      "title": "Inference jobs by state",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "gateway-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 48,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "gateway_jobs",
          "refId": "A",
          "legendFormat": "{{state}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 14,
      "title": "Inference queue pressure",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "gateway-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 48,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum without (state) (gateway_jobs{state=~\"queued|running\"}) / gateway_queue_capacity",
          "refId": "A",
          "legendFormat": "Active / capacity"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      }
    },
    {
      "id": 15,
      "title": "Oldest ready inference job",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "gateway-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 56,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "gateway_queue_oldest_ready_seconds",
          "refId": "A",
          "legendFormat": "Ready age"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 16,
      "title": "Inference workers",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "gateway-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 56,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "gateway_workers_alive",
          "refId": "A",
          "legendFormat": "Alive"
        },
        {
          "expr": "gateway_workers_configured",
          "refId": "B",
          "legendFormat": "Configured"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 17,
      "title": "Inference retries and lease recovery",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "gateway-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 64,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "increase(gateway_job_events_total{event=~\"retried|lease_expired|dead_letter\"}[5m])",
          "refId": "A",
          "legendFormat": "{{event}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 18,
      "title": "Inference submission backpressure",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "gateway-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 64,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(gateway_http_requests_total{route=\"/jobs\",method=\"POST\",status=\"429\"}[5m])) or vector(0)",
          "refId": "A",
          "legendFormat": "HTTP 429"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    }
  ]
}
